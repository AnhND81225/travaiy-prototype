# Cấu hình kết nối Backend API cho Travaiy Web
# -----------------------------------------------------------------------------
# Base URL của Backend API.
# - Trong môi trường local có Vite Proxy: để '/api/v1'
# - Nếu gọi trực tiếp cross-origin: 'http://127.0.0.1:18080/api/v1' hoặc domain production
VITE_API_BASE_URL=/api/v1

# Target cho Vite Dev Server Proxy (chuyển tiếp /api sang port của TravAIy Backend)
VITE_BACKEND_PROXY_URL=http://127.0.0.1:18080

# Thời gian chờ tối đa cho mỗi request (tính theo milliseconds, mặc định 15000ms = 15s)
VITE_API_TIMEOUT=15000
